# Server
PORT=3001
NODE_ENV=production

# Jina AI Reader (optional — works without key, key gives higher rate limits)
# Get free key at: https://jina.ai/reader/
JINA_API_KEY=your_jina_api_key_here

# Voyage AI Embeddings (required)
# Get free key at: https://www.voyageai.com/ (100M tokens/month free)
VOYAGE_API_KEY=your_voyage_api_key_here

# Upstash Vector Database (required)
# Get free at: https://upstash.com/ (10k vectors, 10k queries/day free)
UPSTASH_VECTOR_URL=https://your-index.upstash.io
UPSTASH_VECTOR_TOKEN=your_upstash_vector_token_here

# Groq LLM API (required)
# Get free key at: https://console.groq.com/ (14.4k requests/day free)
GROQ_API_KEY=your_groq_api_key_here
